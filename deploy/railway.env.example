# Required Railway service variables (values are examples/placeholders only).
APP_ENV=production
APP_NAME=Label Guardian API
LOG_LEVEL=INFO

AUTH_ENABLED=true
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_BOOTSTRAP_ADMIN_EMAILS=admin@example.com

DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?ssl=require
DATASET_BACKEND=database
DATASET_ID=nuscenes
DATASET_VERSION=v1.0-mini
DATASET_DEFAULT_SPLIT=smoke
AGENT_EVALUATION_CACHE_ENTRIES=128

CORS_ORIGINS=https://<VERCEL_PRODUCTION_DOMAIN>

LABEL_GUARDIAN_STORAGE_BACKEND=gcs
LABEL_GUARDIAN_GCS_BUCKET=<GCS_BUCKET_NAME>
LABEL_GUARDIAN_GCS_PROJECT=<GCP_PROJECT_ID>
LABEL_GUARDIAN_GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"<GCP_PROJECT_ID>","private_key_id":"<GCP_PRIVATE_KEY_ID>","private_key":"<GCP_PRIVATE_KEY_PEM>","client_email":"<GCP_SERVICE_ACCOUNT_EMAIL>","client_id":"<GCP_CLIENT_ID>","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"<GCP_CLIENT_CERT_URL>"}

# Optional only when Agent execution is enabled.
# The Docker image already sets YOLO_MODEL_NAME=/app/models/yolo26n.pt.
# Configure exactly one LLM provider key, or set LABEL_QA_LLM_PROVIDER when
# multiple keys are present.
OPENAI_API_KEY=
GOOGLE_API_KEY=
LABEL_QA_LLM_PROVIDER=auto
