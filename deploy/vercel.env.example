# Vercel project environment variables. VITE_* values are public at build time;
# never put database passwords, GCS private keys, JWT secrets or LLM keys here.
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=https://<RAILWAY_PUBLIC_DOMAIN>
VITE_DATASET_ID=nuscenes
VITE_DATASET_NAME=nuScenes cloud dataset
VITE_DATASET_FORMAT=nuScenes
VITE_DATASET_VERSION=v1.0-mini
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<SUPABASE_PUBLISHABLE_OR_ANON_KEY>
