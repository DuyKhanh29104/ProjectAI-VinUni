# Copy this file to /opt/label-guardian/.env.production on the self-hosted runner.
# Do not commit the real file.

APP_ENV=production
LOG_LEVEL=INFO
AUTH_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# Public HTTPS origins where users open the Vercel frontend. Required by production CORS validation.
CORS_ORIGINS=https://labelguardian.space,https://www.labelguardian.space

# Supabase Auth. Use the anon/publishable key only for VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<SUPABASE_PUBLISHABLE_OR_ANON_KEY>
VITE_AUTH_MODE=supabase

# Supabase PostgreSQL. Use Session Pooler port 5432 and percent-encode passwords.
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?ssl=require
LABEL_GUARDIAN_DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require
# Keep the API below Supabase's session-pooler client cap. Increase only if the
# Supabase pool size is raised.
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=0

# Official cloud dataset served by this deployment.
DATASET_BACKEND=database
DATASET_ID=nuscenes
DATASET_VERSION=v1.0-trainval
DATASET_DEFAULT_SPLIT=trainval-full
VITE_DATASET_NAME=nuScenes cloud dataset
VITE_DATASET_FORMAT=nuScenes

# Private GCS image/frame streaming through FastAPI.
LABEL_GUARDIAN_STORAGE_BACKEND=gcs
LABEL_GUARDIAN_GCS_BUCKET=label_guardian_bucket
LABEL_GUARDIAN_GCS_PROJECT=ai-lab-16-gcp-505508
LABEL_GUARDIAN_GCS_PUBLIC_URL=https://storage.googleapis.com/label_guardian_bucket
# Prefer ADC on the runner, or set exactly one of these:
# LABEL_GUARDIAN_GCS_CREDENTIALS_PATH=/opt/label-guardian/secrets/gcp-service-account.json
# LABEL_GUARDIAN_GCS_CREDENTIALS_JSON={"type":"service_account",...}

# Docker build cache. BuildKit cache mounts retain downloaded pip and npm packages.
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Runtime paths and ports on the self-hosted server.
SELFHOST_ENV_FILE=/opt/label-guardian/.env.production
SELFHOST_DATA_DIR=/opt/label-guardian/data
SELFHOST_GCLOUD_CONFIG_DIR=/opt/label-guardian/gcloud

# Public API deployment. Point this domain's DNS A record to the server IP,
# then run compose with --profile internet. Vercel serves the frontend.
PUBLIC_DOMAIN=api.labelguardian.space
ACME_EMAIL=admin@example.com
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0

# Optional Agent explanation key. Without it, deterministic QA still runs and
# the explanation field reports the configured fallback reason.
OPENAI_API_KEY=
