VITE_DATA_SOURCE=api
# Để trống khi chạy Vite với proxy /api cục bộ.
VITE_API_BASE_URL=
# Proxy backend local cho /api. Đổi port khi chạy song song nhiều workspace.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Keep these values identical to backend DATASET_ID/DATASET_VERSION. One API
# deployment currently serves one configured dataset release.
VITE_DATASET_ID=nuscenes
VITE_DATASET_NAME=nuScenes cloud dataset
VITE_DATASET_FORMAT=nuScenes
VITE_DATASET_VERSION=v1.0-mini
VITE_DATASET_DEFAULT_SPLIT=product

# `mock` keeps the local role simulator. Use `supabase` for real login/RBAC.
VITE_AUTH_MODE=mock
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# Supabase publishable/anon key is designed to be present in browser code.
VITE_SUPABASE_ANON_KEY=<SUPABASE_PUBLISHABLE_OR_ANON_KEY>

# Optional password-free buttons for a dedicated demo environment. Create one
# Supabase Auth account per role and assign the matching role in
# public.application_users. VITE_* values are included in the browser bundle,
# so never use real staff accounts or passwords here.
VITE_SUPABASE_DEMO_ANNOTATOR_EMAIL=<DEMO_ANNOTATOR_EMAIL>
VITE_SUPABASE_DEMO_ANNOTATOR_PASSWORD=<DEMO_ANNOTATOR_PASSWORD>
VITE_SUPABASE_DEMO_REVIEWER_EMAIL=<DEMO_REVIEWER_EMAIL>
VITE_SUPABASE_DEMO_REVIEWER_PASSWORD=<DEMO_REVIEWER_PASSWORD>
VITE_SUPABASE_DEMO_ADMIN_EMAIL=<DEMO_ADMIN_EMAIL>
VITE_SUPABASE_DEMO_ADMIN_PASSWORD=<DEMO_ADMIN_PASSWORD>
