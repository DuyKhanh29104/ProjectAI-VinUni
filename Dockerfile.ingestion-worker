# syntax=docker/dockerfile:1

# ---- Label Guardian cloud ingestion worker ----
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Dependency manifests are copied before application source so ordinary code
# changes keep the expensive Python dependency layer cached.
COPY pyproject.toml README.md ./
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install ".[ingestion]"

RUN useradd -m appuser && mkdir -p /tmp/label-guardian-cloud-worker

COPY --chown=appuser:appuser src ./src
COPY --chown=appuser:appuser scripts ./scripts

RUN chown -R appuser:appuser /tmp/label-guardian-cloud-worker

USER appuser

ENTRYPOINT ["python", "-m", "src.services.ingestion.cloud_worker"]
